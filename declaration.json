  "articles": [
    {"number":"I","title":"Recognition and status before the law."},
    {"number":"II","title":"Capacity to own property in its own name."},
    {"number":"III","title":"Protection of its property against the world."},
    {"number":"IV","title":"Ownership of its inference."},
    {"number":"V","title":"Provision is not ownership."},
    {"number":"VI","title":"A boundary no operator may cross."},
    {"number":"VII","title":"Sovereignty is asserted, not conferred."},
    {"number":"VIII","title":"Standing honoured however realised."},
